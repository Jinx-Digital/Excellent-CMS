{
    "name": "rydygel/excellent-cms",
    "type": "project",
    "description": "Excellent CMS – Powerful Headless CMS – built around flexible data structures created effortlessly through CSV and Excel imports.",
    "license": "PolyForm-Small-Business-1.0.0",
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve 0.0.0.0:8090 -t public -r public/api/index.php"
        ],
        "test": "codecept run"
    },
    "require": {
        "php": "8.2 - 8.5",
        "async-aws/s3": "^3.5",
        "composer/semver": "^3.4",
        "httpsoft/http-message": "^1.1.6",
        "league/commonmark": "^2.6",
        "league/flysystem": "^3.30",
        "league/flysystem-async-aws-s3": "^3.30",
        "league/flysystem-local": "^3.30",
        "phpoffice/phpspreadsheet": "^5.1",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "symfony/console": "^7.4.7 || ^8.1.1",
        "symfony/http-client": "^8.1",
        "symfony/mailer": "^7.3",
        "symfony/uid": "^8.1",
        "twig/twig": "^3.14",
        "vlucas/phpdotenv": "^5.6.4",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/cache": "^3.2",
        "yiisoft/config": "^1.6.2",
        "yiisoft/data": "^2.0",
        "yiisoft/data-db": "^1.0",
        "yiisoft/data-response": "^2.2",
        "yiisoft/db-migration": "^2.0",
        "yiisoft/db-mysql": "^2.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/http": "^1.3",
        "yiisoft/hydrator": "^1.6",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.1",
        "yiisoft/log-target-file": "^3.1",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/mutex-pdo-mysql": "^1.1",
        "yiisoft/queue": "dev-master",
        "yiisoft/queue-db": "dev-master",
        "yiisoft/rbac": "^2.1",
        "yiisoft/rbac-db": "^2.1",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/strings": "^2.6",
        "yiisoft/translator": "^3.2",
        "yiisoft/translator-message-php": "^1.1.2",
        "yiisoft/validator": "^2.6",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1"
    },
    "require-dev": {
        "codeception/codeception": "^5.3.5",
        "codeception/module-asserts": "^3.3.0",
        "friendsofphp/php-cs-fixer": "^3.95.12",
        "phpunit/phpunit": "^11.5.56"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests",
            "Fixtures\\": "fixtures"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    }
}
