# Local environment configuration. Copy to .env and adjust.
# In production set these as real environment variables.
APP_ENV=dev
APP_DEBUG=true

# MySQL (MAMP default port 8889)
DB_HOST=127.0.0.1
DB_PORT=8889
DB_NAME=excellent_cms
DB_USER=root
DB_PASSWORD=root

# At least 32 characters, e.g. php -r 'echo bin2hex(random_bytes(32));'
JWT_SECRET=
# Encrypts secrets entered in the admin app (keys and passwords of storages) - base64 of 32 bytes:
# php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Without it, secrets can only be $NAME references to variables of this file. Changing it makes
# the stored secrets unreadable.
APP_ENCRYPTION_KEY=

# Lifetime of a login (CMS users) in seconds, default 7 days
JWT_TTL=604800

# Plugins: ZIPs uploaded in the admin app are unpacked into this folder (must be writable).
# PLUGINS_ENABLED=false switches all plugins off - and their upload.
PLUGINS_DIR=plugins
PLUGINS_ENABLED=true

# Lifetime of preview links (drafts on the website, see the preview address of entities), default 1 hour
PREVIEW_TTL=3600

# Lifetime of OAuth access tokens (client credentials) in seconds, default 1 hour
OAUTH_TOKEN_TTL=3600

# Address of the admin app, used for links in mails (e.g. https://cms.example.com) - empty: host of the request
APP_URL=

# Mails (password reset, confirming a new e-mail address), e.g. smtp://user:pass@smtp.example.com:587
# Empty: mails are written to runtime/logs/mail.log instead of being sent
MAILER_DSN=
MAILER_FROM=noreply@example.com
MAILER_FROM_NAME="Excellent CMS"

# CORS: the public API (content, media of clients, public plugin routes like forms, variables, OAuth tokens)
# answers every website. The admin routes answer only these origins (comma separated) - empty: none, the admin
# app runs on the same address as the API. Only needed for an admin app on another address.
ADMIN_ORIGINS=

# Default rate limit of the content API until an admin changes it in the settings
# (requests per window and client/IP; RATE_LIMIT_ENABLED=false switches it off)
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# Largest import file (rows)
IMPORT_MAX_ROWS=50000

# Media fields: uploads go into the folder storage/ ("local") - more storages (S3, R2, Hetzner, FTP …)
# under Administration › Storages, picked per project. Their settings take $NAME references to
# variables of this file, e.g. key = $S3_KEY.
# Largest upload in MB (PHP's upload_max_filesize / post_max_size must allow it too)
MEDIA_MAX_SIZE=20
# Base URL where the CMS serves files (local and private storages). The API always returns absolute URLs:
# a relative value (default /media) gets scheme and host of the request - behind a proxy or load balancer
# set the full URL (https://cms.example.com/media).
MEDIA_URL=
# Lifetime of signed addresses of protected files in seconds (valid for 1-2 times this long)
MEDIA_SIGNED_TTL=86400
# Largest width and height of images asked for in another size (?w=…&h=…), see README
MEDIA_TRANSFORM_MAX_SIZE=4000

# Web cron for servers without cron jobs (at least 16 characters, e.g. php -r 'echo bin2hex(random_bytes(16));'):
# an outside service calls GET https://<cms>/api/v1/cron?key=<CRON_KEY> every minute - scheduled publishing,
# hourly cleanup. Empty: the address does not exist (use the cron jobs of docs/deployment.md instead).
CRON_KEY=

# Log (runtime/logs/app.log): rotated at this size in MB, the newest old files kept (compressed)
LOG_MAX_SIZE=10
LOG_MAX_FILES=5

# Revisions of records: the newest this many per record are kept (0 = no revisions)
REVISION_LIMIT=50

# Demo data (fixtures): preview address of the landing pages, e.g. the page builder demo of the PHP SDK
# DEMO_PREVIEW_URL=http://localhost:8888/excellent-cms-sdk/demo/page-builder.php?id={{id}}&token={{token}}
# (the live demo: https://demo.excellent.jinx-digital.com/page-builder.php?id={{id}}&token={{token}})
